#!/bin/sh /etc/rc.common
# Persistent copy: must not depend on the package files being replaced.
START=93
STOP=10
USE_PROCD=1
start_service() {
 [ -s /root/diversion-upgrade/active.json ] || return 0
 # Repeated start requests declare the same named instance and command. Do not
 # use restart/stop here: an existing instance may currently be running APK.
 procd_open_instance recovery
 procd_set_param command /bin/sh /root/diversion-upgrade/recovery/loop
 procd_set_param limits core=0
 procd_set_param stdout 1
 procd_set_param stderr 1
 # No respawn: the loop exits when the transaction has released active.json.
 procd_close_instance
}
