#!/bin/sh
set -eu
# APK holds its database lock while running hooks. An extra mkdir lock can
# survive SIGKILL and incorrectly block the next upgrade.
rm -f /var/run/diversion-dns-ui-package-upgrade
if /etc/init.d/diversion-dns-ui running; then
 umask 077
 printf '%s\n' running > /var/run/diversion-dns-ui-package-upgrade
 /etc/init.d/diversion-dns-ui stop
fi
