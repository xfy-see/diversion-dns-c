#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
 local enabled
 config_load diversion-dns-ui
 config_get_bool enabled main enabled 0
 [ "$enabled" = 1 ] || return 0
 mkdir -p /var/run/diversion-dns-ui
 chmod 700 /var/run/diversion-dns-ui
 procd_open_instance
 procd_set_param command /usr/share/diversion-dns-ui/monitor
 procd_set_param respawn 3600 5 3
 procd_set_param limits core=0
 procd_close_instance
}
service_triggers() { procd_add_reload_trigger diversion-dns-ui; }
