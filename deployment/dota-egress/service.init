#!/bin/sh /etc/rc.common
START=97
STOP=14
USE_PROCD=1
start_service() {
 test -f /etc/pnw-control/dota-egress/config.json || return 0
 procd_open_instance
 procd_set_param command /bin/sh /etc/pnw-control/dota-egress/daemon.sh
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
stop_service() {
 (flock -n 9 || exit 0
 export DIVERSION_CN_DEPLOY_LOCK_HELD=1
 lua -e 'dofile("/etc/pnw-control/dota-egress.lua").collect(true)'
 ) 9>/var/lock/diversion-dns-deploy.lock
}
