#!/bin/sh /etc/rc.common
START=18
STOP=09
USE_PROCD=1
start_service() {
 [ -f /etc/diversion-dns-c/active ] || return 0
 /etc/diversion-dns-c/apply-policy.sh || { /etc/diversion-dns-c/enable-rescue.sh; return 1; }
 # A durable transaction permits C while client DNS remains on ISP. After a
 # crash/reboot guard reconciles the transaction before another recovery.
 if [ -f /etc/diversion-dns-c/degraded ]; then
  [ -d /etc/diversion-dns-c/recovering ] || return 0
 fi
 procd_open_instance resolver
 procd_set_param command /usr/sbin/diversion-dns-c start -c /etc/diversion-dns-c/config.conf --cpu 2
 procd_set_param respawn 3600 2 0
 procd_set_param limits core=0 nofile=1024 as=134217728
 procd_set_param file /etc/diversion-dns-c/config.conf /etc/diversion-dns-c/cn-site.txt
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
