#!/bin/sh /etc/rc.common
START=18
STOP=09
USE_PROCD=1
start_service() {
 base=${DIVERSION_DNS_BASE:-/etc/diversion-dns-c}
 [ -f "$base/active" ] || return 0
 data_managed=0; policy_managed=0
 if [ -e "$base/cn-data/enabled" ] || [ -L "$base/cn-data/enabled" ] ||
    [ -e "$base/cn-data/current" ] || [ -L "$base/cn-data/current" ] ||
    [ -d "$base/cn-data/generations" ] ||
    [ -e "$base/cn-data/pending" ] || [ -L "$base/cn-data/pending" ] ||
    [ -e "$base/cn-data/repair-pending" ] || [ -L "$base/cn-data/repair-pending" ]; then data_managed=1; fi
 if [ -e "$base/cn-policy/enabled" ] || [ -L "$base/cn-policy/enabled" ] ||
    [ -e "$base/cn-policy/current" ] || [ -L "$base/cn-policy/current" ] ||
    [ -d "$base/cn-policy/generations" ]; then policy_managed=1; fi
 if [ "$data_managed" = 1 ] || [ "$policy_managed" = 1 ]; then
  if [ "${DIVERSION_CN_DEPLOY_LOCK_HELD:-0}" != 1 ]; then
   exec 9>"${DIVERSION_DNS_LOCK:-/var/lock/diversion-dns-deploy.lock}"
   flock 9 || return 1
  fi
 fi
 # Validate files before the policy helper can load sets.nft at boot. This
 # read-only check requires no kernel table, restart, or nested data lock.
 if [ "$data_managed" = 1 ]; then
  if [ ! -x "$base/cn-data.sh" ] ||
     ! DIVERSION_CN_DEPLOY_LOCK_HELD=1 "$base/cn-data.sh" check-start; then
   "$base/enable-rescue.sh"
   return 1
  fi
 fi
 # The managed verifier already invokes the approved helper when needed. Never
 # follow it with a second unchecked apply, including boot and manual starts.
 if [ "$policy_managed" = 1 ]; then
  if [ ! -x "$base/cn-policy.sh" ] ||
     ! DIVERSION_CN_DEPLOY_LOCK_HELD=1 "$base/cn-policy.sh" audit-runtime; then
   "$base/enable-rescue.sh"
   return 1
  fi
 else
  "$base/apply-policy.sh" || { "$base/enable-rescue.sh"; return 1; }
 fi
 # A durable transaction permits C while client DNS remains on ISP. After a
 # crash/reboot guard reconciles the transaction before another recovery.
 if [ -f "$base/degraded" ]; then
  [ -d "$base/recovering" ] || return 0
 fi
 procd_open_instance resolver
 procd_set_param command /usr/sbin/diversion-dns-c start -c "$base/config.conf" --cpu 2
 procd_set_param respawn 3600 2 0
 procd_set_param limits core=0 nofile=1024 as=134217728
 procd_set_param file "$base/config.conf" "$base/cn-site.txt"
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
